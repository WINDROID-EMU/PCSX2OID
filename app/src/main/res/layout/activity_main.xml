<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_in_game"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false"
    android:elevation="0dp"
    tools:context=".activities.MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/in_game_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:keepScreenOn="true">

        <FrameLayout
            android:id="@+id/fl_board"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@android:color/black"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btn_drawer_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:contentDescription="@string/drawer_toggle_content_description"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:backgroundTint="?attr/colorPrimary"
            app:tint="?attr/colorOnPrimary"
            app:srcCompat="@drawable/playstation4_touchpad"
            app:fabCustomSize="@dimen/in_game_toggle_fab_size"
            app:maxImageSize="@dimen/in_game_toggle_fab_icon"
            app:layout_constraintHorizontal_bias="0.5" />

        <!-- Bottom select/start row -->
        <LinearLayout
            android:id="@+id/ll_pad_select_start"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="bottom|center_horizontal"
            android:orientation="horizontal"
            android:visibility="gone"
            android:paddingBottom="12dp">

            <kr.co.iefriends.pcsx2.input.view.PSButtonView
                android:id="@+id/btn_pad_l3"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_margin="8dp" />

            <kr.co.iefriends.pcsx2.input.view.PSButtonView
                android:id="@+id/btn_pad_select"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_margin="8dp" />

            <kr.co.iefriends.pcsx2.input.view.PSButtonView
                android:id="@+id/btn_pad_start"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_margin="8dp" />

            <kr.co.iefriends.pcsx2.input.view.PSButtonView
                android:id="@+id/btn_pad_r3"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_margin="8dp" />

        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ll_pad_shoulders_left"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:visibility="gone">

            <kr.co.iefriends.pcsx2.input.view.PSShoulderButtonView
                android:id="@+id/btn_pad_l2"
                android:layout_width="85dp"
                android:layout_height="50dp"
                android:layout_margin="4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <kr.co.iefriends.pcsx2.input.view.PSShoulderButtonView
                android:id="@+id/btn_pad_l1"
                android:layout_width="85dp"
                android:layout_height="50dp"
                android:layout_margin="4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btn_pad_l2" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ll_pad_shoulders_right"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:visibility="gone">

            <kr.co.iefriends.pcsx2.input.view.PSShoulderButtonView
                android:id="@+id/btn_pad_r2"
                android:layout_width="85dp"
                android:layout_height="50dp"
                android:layout_margin="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <kr.co.iefriends.pcsx2.input.view.PSShoulderButtonView
                android:id="@+id/btn_pad_r1"
                android:layout_width="85dp"
                android:layout_height="50dp"
                android:layout_margin="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btn_pad_r2" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ll_pad_right"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:visibility="gone">

            <kr.co.iefriends.pcsx2.input.view.JoystickView
                android:id="@+id/joystick_right"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_marginEnd="180dp"
                android:layout_marginBottom="60dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <FrameLayout
                android:id="@+id/ll_pad_right_buttons"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="40dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center"
                    android:orientation="vertical">

                    <!-- Top button (Triangle/Y) -->
                    <kr.co.iefriends.pcsx2.input.view.PSButtonView
                        android:id="@+id/btn_pad_y"
                        android:layout_width="65dp"
                        android:layout_height="65dp"
                        android:layout_marginBottom="-10dp" />

                    <!-- Middle row (Square/X and Circle/B) -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="-10dp">

                        <kr.co.iefriends.pcsx2.input.view.PSButtonView
                            android:id="@+id/btn_pad_x"
                            android:layout_width="65dp"
                            android:layout_height="65dp"
                            android:layout_marginEnd="25dp" />

                        <kr.co.iefriends.pcsx2.input.view.PSButtonView
                            android:id="@+id/btn_pad_b"
                            android:layout_width="65dp"
                            android:layout_height="65dp" />
                    </LinearLayout>

                    <!-- Bottom button (Cross/A) -->
                    <kr.co.iefriends.pcsx2.input.view.PSButtonView
                        android:id="@+id/btn_pad_a"
                        android:layout_width="65dp"
                        android:layout_height="65dp" />
                </LinearLayout>
            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <kr.co.iefriends.pcsx2.input.view.JoystickView
            android:id="@+id/joystick_left"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="20dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <kr.co.iefriends.pcsx2.input.view.DPadView
            android:id="@+id/dpad_view"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:layout_marginStart="10dp"
            android:layout_marginBottom="20dp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/joystick_left"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Home overlay when no game selected -->
        <include
            layout="@layout/activity_game_selector"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <include
            android:id="@+id/control_editor_include"
            layout="@layout/layout_control_editor"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/drawer_card"
        android:layout_width="@dimen/in_game_drawer_width"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:layout_marginStart="0dp"
        android:background="@android:color/transparent"
        android:elevation="0dp">

        <include
            android:id="@+id/drawer_in_game_include"
            layout="@layout/drawer_in_game" />

    </FrameLayout>

</androidx.drawerlayout.widget.DrawerLayout>
